{
  "$schema": "https://schemas.tokens.studio/v1.0.0/tokens.json",
  "color": {
    "bg": {
      "default": "#FFFFFF",
      "soft": "#F6F8FB",
      "blue": "#EEF4FB",
      "mint": "#E8F5F0"
    },
    "ink": {
      "primary": "#0F1F33",
      "secondary": "#3D4F66",
      "tertiary": "#6B7A8F"
    },
    "rule": {
      "default": "#E2E8F0",
      "soft": "#EEF2F7"
    },
    "brand": {
      "default": "#1E5BA8",
      "lighter": "#2A6FC4",
      "deep": "#133E78",
      "soft": "#D4E4F5",
      "tint": "#E8F1FB"
    },
    "accent": {
      "default": "#14B8A6",
      "soft": "#CCEEE8"
    },
    "warn": {
      "default": "#E07A3D",
      "soft": "#FCE7D6"
    },
    "whatsapp": {
      "default": "#25D366"
    }
  },
  "font": {
    "family": {
      "sans": "\"Plus Jakarta Sans\", -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", Helvetica, sans-serif"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "size": {
      "h1": "clamp(40px, 5.6vw, 72px)",
      "h2": "clamp(32px, 4vw, 52px)",
      "h3": "clamp(22px, 2vw, 26px)",
      "h4": "18px",
      "lead": "clamp(17px, 1.4vw, 19px)",
      "body": "16px",
      "meta": "13px",
      "eyebrow": "13px"
    },
    "lineHeight": {
      "h1": 1.05,
      "h2": 1.1,
      "h3": 1.2,
      "h4": 1.3,
      "lead": 1.55,
      "body": 1.65,
      "tight": 1.15
    },
    "letterSpacing": {
      "tight": "-0.01em",
      "normal": "0",
      "eyebrow": "0.02em"
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "9": "96px",
    "10": "128px"
  },
  "layout": {
    "maxWidth": "1240px",
    "gutter": "clamp(20px, 4vw, 40px)"
  },
  "radius": {
    "sm": "10px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "pill": "999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(15, 31, 51, 0.04), 0 1px 3px rgba(15, 31, 51, 0.06)",
    "md": "0 4px 12px rgba(15, 31, 51, 0.06), 0 2px 4px rgba(15, 31, 51, 0.04)",
    "lg": "0 24px 48px -16px rgba(15, 31, 51, 0.18), 0 8px 24px -8px rgba(15, 31, 51, 0.08)",
    "blue": "0 24px 48px -16px rgba(30, 91, 168, 0.25)"
  },
  "breakpoint": {
    "mobile": "600px",
    "tablet": "900px",
    "desktop": "1200px"
  },
  "tailwindMapping": {
    "note": "Use these as the source-of-truth for tailwind.config.ts. Map color.brand.default to theme.colors.brand.DEFAULT, etc.",
    "example": {
      "colors": {
        "brand": {
          "DEFAULT": "#1E5BA8",
          "deep": "#133E78",
          "lighter": "#2A6FC4",
          "soft": "#D4E4F5",
          "tint": "#E8F1FB"
        },
        "ink": {
          "DEFAULT": "#0F1F33",
          "2": "#3D4F66",
          "3": "#6B7A8F"
        }
      }
    }
  }
}
